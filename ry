(function() {
    'use strict';
    if (window.MultiEmbedPlugin) return;
    window.MultiEmbedPlugin = true;

    // --- CORS PROXY - Using ONLY corsproxy.io with key ---
    const CORS_KEY = '544f778e';
    const CORS_PROXY = `https://corsproxy.io/?${CORS_KEY}&`;
    
    async function fetchWithProxy(url) {
        try {
            const response = await fetch(CORS_PROXY + encodeURIComponent(url), {
                method: 'GET',
                headers: {
                    'Accept': 'text/html,application/xhtml+xml,application/json,text/plain,*/*',
                    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
                    'Referer': url
                },
                redirect: 'follow'
            });
            if (response.ok) {
                const text = await response.text();
                if (text && text.length > 100) return text;
            }
            throw new Error(`HTTP ${response.status}`);
        } catch (e) {
            console.log('[Multi-Embed] Proxy failed:', e.message);
            throw e;
        }
    }

    function decodeHtmlEntities(value) {
        return String(value || '')
            .replace(/&amp;/g, '&')
            .replace(/&quot;/g, '"')
            .replace(/&#39;/g, "'")
            .replace(/&lt;/g, '<')
            .replace(/&gt;/g, '>');
    }

    function normalizeStreamUrl(url, baseUrl) {
        if (!url) return null;

        let cleanUrl = decodeHtmlEntities(url)
            .replace(/\\\//g, '/')
            .replace(/\u0026/g, '&')
            .replace(/^['"]|['"]$/g, '')
            .trim();

        if (!cleanUrl || cleanUrl.indexOf('blob:') === 0 || cleanUrl.indexOf('data:') === 0) return null;

        try {
            cleanUrl = new URL(cleanUrl, baseUrl).href;
        } catch (e) {
            return null;
        }

        return cleanUrl;
    }

    function classifyStreamUrl(url) {
        const cleanUrl = (url || '').split('#')[0].split('?')[0].toLowerCase();
        if (/\.m3u8$/.test(cleanUrl)) return 'hls';
        if (/\.mp4$/.test(cleanUrl)) return 'mp4';
        if (/\.mpd$/.test(cleanUrl)) return 'dash';
        if (/\.ts$/.test(cleanUrl)) return 'ts';
        return null;
    }

    function getQualityScore(type, url) {
        let score = 0;
        if (type === 'hls') score += 100;
        if (type === 'mp4') score += 80;
        if (type === 'dash') score += 70;
        if (type === 'ts') score += 50;
        if (/master|playlist|index/.test(url.toLowerCase())) score += 20;
        if (/360|480|low/.test(url.toLowerCase())) score -= 30;
        if (/720|hd/.test(url.toLowerCase())) score += 10;
        if (/1080|fhd/.test(url.toLowerCase())) score += 20;
        if (/4k|uhd/.test(url.toLowerCase())) score += 30;
        return score;
    }


    function notify(title, text, time) {
        const message = [title, text].filter(Boolean).join(': ');
        try {
            if (typeof Lampa !== 'undefined' && Lampa && Lampa.Notifier && typeof Lampa.Notifier.show === 'function') {
                Lampa.Notifier.show({ title: title || '', text: text || '', time: time || 3000 });
            } else if (typeof Lampa !== 'undefined' && Lampa && Lampa.Noty && typeof Lampa.Noty.show === 'function') {
                Lampa.Noty.show(message);
            } else {
                console.log('[Multi-Embed] ' + message);
            }
        } catch (e) {
            console.log('[Multi-Embed] ' + message);
        }
    }

    function errorMessage(error) {
        if (!error) return 'Unknown error';
        return error.message || String(error);
    }

    function openPlayer(streamInfo, sourceData, movie) {
        const entry = {
            url: streamInfo.url,
            title: movie.title || movie.name || sourceData.name,
            quality: streamInfo.type === 'hls' ? 'auto' : undefined
        };

        console.log('[Multi-Embed] Playing source:', sourceData.name, entry);
        
        if (typeof Lampa !== 'undefined' && Lampa && Lampa.Player && typeof Lampa.Player.play === 'function') {
            Lampa.Player.play(entry);
            if (Lampa.Player.playlist && typeof Lampa.Player.playlist === 'function') {
                Lampa.Player.playlist([entry]);
            }
        } else {
            notify('Error', 'Player not available', 3000);
        }
    }

    function streamFromUrl(url, baseUrl) {
        const normalizedUrl = normalizeStreamUrl(url, baseUrl);
        const type = classifyStreamUrl(normalizedUrl);
        return type ? { type: type, url: normalizedUrl } : null;
    }

    function parseDirectStreamPayload(payload, baseUrl) {
        if (!payload) return null;

        if (typeof payload === 'object') {
            const keys = ['url', 'file', 'src', 'link', 'stream', 'hls', 'playlist', 'sources'];
            for (const key of keys) {
                if (payload[key]) {
                    const streamInfo = parseDirectStreamPayload(payload[key], baseUrl);
                    if (streamInfo) return streamInfo;
                }
            }
            if (Array.isArray(payload.sources)) {
                for (const source of payload.sources) {
                    const streamInfo = parseDirectStreamPayload(source, baseUrl);
                    if (streamInfo) return streamInfo;
                }
            }
            return null;
        }

        const text = String(payload);
        
        // First try direct URL extraction using m3u8Sniffer-style pattern (comprehensive)
        // Pattern from m3u8Sniffer: matches any http(s) URL containing .m3u8 with optional query params
        const m3u8Pattern = /https?:\/\/[^\s"'<>]*\.m3u8[^\s"'<>]*/gi;
        const mp4Pattern = /https?:\/\/[^\s"'<>]*\.mp4[^\s"'<>]*/gi;
        const tsPattern = /https?:\/\/[^\s"'<>]*\.ts[^\s"'<>]*/gi;
        
        let match;
        
        // Try m3u8 first (highest priority for adaptive streaming)
        while ((match = m3u8Pattern.exec(text)) !== null) {
            const candidate = match[0].replace(/[)]$/, ''); // Clean trailing parens
            const streamInfo = streamFromUrl(candidate, baseUrl);
            if (streamInfo) {
                console.log('[Multi-Embed] Found m3u8 via sniffer pattern:', candidate.substring(0, 100));
                return streamInfo;
            }
        }
        
        // Try mp4
        while ((match = mp4Pattern.exec(text)) !== null) {
            const candidate = match[0].replace(/[)]$/, '');
            const streamInfo = streamFromUrl(candidate, baseUrl);
            if (streamInfo) {
                console.log('[Multi-Embed] Found mp4 via sniffer pattern:', candidate.substring(0, 100));
                return streamInfo;
            }
        }
        
        // Try ts
        while ((match = tsPattern.exec(text)) !== null) {
            const candidate = match[0].replace(/[)]$/, '');
            const streamInfo = streamFromUrl(candidate, baseUrl);
            if (streamInfo) {
                console.log('[Multi-Embed] Found ts via sniffer pattern:', candidate.substring(0, 100));
                return streamInfo;
            }
        }
        
        // Enhanced regex patterns for various embed formats
        const patterns = [
            // Direct media URLs with more extensions
            /https?:\/\/[^"'\s<>]+\.(?:m3u8|mp4|ts|m4s)[^"'\s<>]*/gi,
            // Common player config patterns
            /(?:file|url|src|link|hls|playlist|data-url)["']?\s*[:=]\s*["']([^"']+)["']/gi,
            /(?:file|url|src|link|hls|playlist)["']?\s*[:=]\s*["']?([^"'\s}]+)["']?/gi,
            // HTML5 video/audio sources
            /<source[^>]+src=["']([^"']+)["'][^>]*>/gi,
            /<video[^>]+src=["']([^"']+)["'][^>]*>/gi,
            /<audio[^>]+src=["']([^"']+)["'][^>]*>/gi,
            // JWPlayer/Video.js configs
            /setup\(\{[^}]*file:\s*["']([^"']+)["']/gi,
            /player\.setup\(\{[^}]*sources:\s*\[\{[^}]*file:\s*["']([^"']+)["']/gi,
            // HLS.js and other players
            /loadSource\(["']([^"']+)["']\)/gi,
            // General URL patterns with query params
            /https?:\/\/[^\s"']+\/(?:hls|stream|video|playlist)[^\s"']*\.(?:m3u8|mp4|ts)[^\s"']*/gi
        ];

        for (const pattern of patterns) {
            let match;
            const regex = new RegExp(pattern.source, pattern.flags);
            while ((match = regex.exec(text)) !== null) {
                const candidate = match[1] || match[0];
                if (candidate && typeof candidate === 'string') {
                    const streamInfo = streamFromUrl(candidate.trim(), baseUrl);
                    if (streamInfo) {
                        console.log('[Multi-Embed] Found stream via pattern');
                        return streamInfo;
                    }
                }
            }
        }

        return null;
    }

    async function getDirectStreamUrl(source, movie) {
        const isSeries = !!(movie.name && movie.first_air_date);
        const season = movie.season_number || movie.season || 1;
        const episode = movie.episode_number || movie.episode || 1;

        // Source-specific URL formatting for proper endpoint selection
        const formattedUrl = formatSourceUrl(source, movie, isSeries, season, episode);

        if (source.name === 'MultiEmbed') {
            const direct = await getDirectStreamFromMultiEmbed(movie.id, isSeries, season, episode);
            if (direct) return direct;
        }

        const fromUrl = streamFromUrl(formattedUrl, formattedUrl);
        if (fromUrl) return fromUrl;

        return await extractStreamFromIframe(formattedUrl);
    }

    function formatSourceUrl(source, movie, isSeries, season, episode) {
        const tmdbId = movie.id;
        
        // AutoEmbed - uses TMDB ID with specific format for movies vs TV
        if (source.name === 'AutoEmbed') {
            if (isSeries) {
                return `https://autoembed.co/tv/tmdb/${tmdbId}-${season}-${episode}`;
            } else {
                return `https://autoembed.co/movie/tmdb/${tmdbId}`;
            }
        }
        
        // MultiEmbed - separate endpoints for movies/series
        if (source.name === 'MultiEmbed') {
            if (isSeries) {
                return `https://multiembed.mov/directstream.php?video_id=${tmdbId}&tmdb=1&s=${season}&e=${episode}`;
            } else {
                return `https://multiembed.mov/?video_id=${tmdbId}&tmdb=1`;
            }
        }
        
        // VidSrc.to - distinct paths for movies and TV
        if (source.name === 'VidSrc.to') {
            if (isSeries) {
                return `https://vidsrc.to/embed/tv/${tmdbId}/${season}/${episode}`;
            } else {
                return `https://vidsrc.to/embed/movie/${tmdbId}`;
            }
        }
        
        // VidSrc.xyz - distinct paths for movies and TV
        if (source.name === 'VidSrc.xyz') {
            if (isSeries) {
                return `https://vidsrc.xyz/embed/tv/${tmdbId}/${season}/${episode}`;
            } else {
                return `https://vidsrc.xyz/embed/movie/${tmdbId}`;
            }
        }
        
        // Embed.su - distinct paths for movies and TV
        if (source.name === 'Embed.su') {
            if (isSeries) {
                return `https://embed.su/embed/tv/${tmdbId}/${season}/${episode}`;
            } else {
                return `https://embed.su/embed/movie/${tmdbId}`;
            }
        }
        
        // 2Embed - uses query params with type distinction
        if (source.name === '2Embed') {
            if (isSeries) {
                return `https://www.2embed.to/embed/tmdb/tv?id=${tmdbId}&s=${season}&e=${episode}`;
            } else {
                return `https://www.2embed.to/embed/tmdb/movie?id=${tmdbId}`;
            }
        }
        
        // SmashyStream - path-based distinction
        if (source.name === 'SmashyStream') {
            if (isSeries) {
                return `https://embed.smashy.stream/tv/${tmdbId}/${season}/${episode}`;
            } else {
                return `https://embed.smashy.stream/movie/${tmdbId}`;
            }
        }
        
        // SuperEmbed - path-based distinction
        if (source.name === 'SuperEmbed') {
            if (isSeries) {
                return `https://superembed.stream/tv/${tmdbId}/${season}/${episode}`;
            } else {
                return `https://superembed.stream/movie/${tmdbId}`;
            }
        }
        
        // MoviesAPI - hyphenated format
        if (source.name === 'MoviesAPI') {
            if (isSeries) {
                return `https://moviesapi.club/tv/${tmdbId}-${season}-${episode}`;
            } else {
                return `https://moviesapi.club/movie/${tmdbId}`;
            }
        }
        
        return source.url;
    }

    // --- 1. SOURCES CONFIGURATION ---
    function getSources(movie) {
        const tmdbId = movie.id;
        const isSeries = !!(movie.name && movie.first_air_date);
        const season = movie.season_number || movie.season || 1;
        const episode = movie.episode_number || movie.episode || 1;
        const sources = [];

        if (isSeries) {
            sources.push({ name: 'MultiEmbed', url: `https://multiembed.mov/directstream.php?video_id=${tmdbId}&tmdb=1&s=${season}&e=${episode}`, type: 'mixed', priority: 1 });
            sources.push({ name: 'VidSrc.to', url: `https://vidsrc.to/embed/tv/${tmdbId}/${season}/${episode}`, type: 'embed', priority: 2 });
            sources.push({ name: 'VidSrc.xyz', url: `https://vidsrc.xyz/embed/tv/${tmdbId}/${season}/${episode}`, type: 'embed', priority: 3 });
            sources.push({ name: 'Embed.su', url: `https://embed.su/embed/tv/${tmdbId}/${season}/${episode}`, type: 'embed', priority: 4 });
            sources.push({ name: 'AutoEmbed', url: `https://autoembed.co/tv/tmdb/${tmdbId}-${season}-${episode}`, type: 'embed', priority: 5 });
            sources.push({ name: '2Embed', url: `https://www.2embed.to/embed/tmdb/tv?id=${tmdbId}&s=${season}&e=${episode}`, type: 'embed', priority: 6 });
            sources.push({ name: 'SmashyStream', url: `https://embed.smashy.stream/tv/${tmdbId}/${season}/${episode}`, type: 'embed', priority: 7 });
            sources.push({ name: 'SuperEmbed', url: `https://superembed.stream/tv/${tmdbId}/${season}/${episode}`, type: 'embed', priority: 8 });
            sources.push({ name: 'MoviesAPI', url: `https://moviesapi.club/tv/${tmdbId}-${season}-${episode}`, type: 'embed', priority: 9 });
        } else {
            sources.push({ name: 'MultiEmbed', url: `https://multiembed.mov/?video_id=${tmdbId}&tmdb=1`, type: 'mixed', priority: 1 });
            sources.push({ name: 'VidSrc.to', url: `https://vidsrc.to/embed/movie/${tmdbId}`, type: 'embed', priority: 2 });
            sources.push({ name: 'VidSrc.xyz', url: `https://vidsrc.xyz/embed/movie/${tmdbId}`, type: 'embed', priority: 3 });
            sources.push({ name: 'Embed.su', url: `https://embed.su/embed/movie/${tmdbId}`, type: 'embed', priority: 4 });
            sources.push({ name: 'AutoEmbed', url: `https://autoembed.co/movie/tmdb/${tmdbId}`, type: 'embed', priority: 5 });
            sources.push({ name: '2Embed', url: `https://www.2embed.to/embed/tmdb/movie?id=${tmdbId}`, type: 'embed', priority: 6 });
            sources.push({ name: 'SmashyStream', url: `https://embed.smashy.stream/movie/${tmdbId}`, type: 'embed', priority: 7 });
            sources.push({ name: 'SuperEmbed', url: `https://superembed.stream/movie/${tmdbId}`, type: 'embed', priority: 8 });
            sources.push({ name: 'MoviesAPI', url: `https://moviesapi.club/movie/${tmdbId}`, type: 'embed', priority: 9 });
        }

        sources.sort((a, b) => a.priority - b.priority);
        return sources;
    }

    // --- 2. DIRECT STREAM EXTRACTION FROM EMBEDS ---
    async function extractStreamFromIframe(iframeUrl) {
        try {
            console.log('[Multi-Embed] Extracting from:', iframeUrl);
            const html = await fetchWithProxy(iframeUrl);
            if (!html || html.length < 100) {
                console.log('[Multi-Embed] Response too short, trying alternate method');
                return null;
            }
            const streamInfo = parseDirectStreamPayload(html, iframeUrl);
            if (streamInfo) {
                console.log('[Multi-Embed] Found direct stream:', streamInfo.type, streamInfo.url.substring(0, 80));
                return streamInfo;
            }
            console.log('[Multi-Embed] No stream found in page content');
            return null;
        } catch (error) {
            console.error('[Multi-Embed] Extract error:', error.message);
            return null;
        }
    }

    // --- 3. MULTIEMBED API DIRECT LINKS ---
    async function getDirectStreamFromMultiEmbed(tmdbId, isSeries, season, episode) {
        try {
            const apiUrl = isSeries 
                ? `https://multiembed.mov/directstream.php?video_id=${tmdbId}&tmdb=1&s=${season}&e=${episode}`
                : `https://multiembed.mov/?video_id=${tmdbId}&tmdb=1`;

            const response = await fetch(apiUrl, { method: 'GET', mode: 'cors', redirect: 'follow' });
            if (!response.ok) throw new Error('Failed');

            const finalUrlStream = streamFromUrl(response.url, apiUrl);
            if (finalUrlStream) return finalUrlStream;

            const body = await response.text();
            return parseDirectStreamPayload(body, response.url || apiUrl);
        } catch (error) {
            return null;
        }
    }

    // --- 4. LAMPA UI COMPONENT ---
    function MultiEmbedComponent(object) {
        if (typeof Lampa === 'undefined' || !Lampa) {
            console.error('[Multi-Embed] Lampa API not available');
            return;
        }
        
        var scroll = new Lampa.Scroll({ mask: true, over: true });
        var files = new Lampa.Explorer(object);
        var html = $('<div></div>');
        var selectedIndex = 0;
        var items = [];
        var sourceItems = [];

        this.create = function() {
            scroll.minus();
            files.appendFiles(scroll.render());
            files.appendHead($('<div class="simple-text" style="padding:1em;text-align:center;font-size:1.2em;">Select Source (Press OK)</div>'));
            return this.render();
        };
        this.render = function() { return files.render(); };

        function scrollToItem(index) {
            if (!items[index] || items.length === 0) return;
            var itemEl = items[index][0];
            var container = scroll.render()[0];
            if (!itemEl || !container) return;

            var itemTop = itemEl.offsetTop;
            var itemBottom = itemTop + itemEl.offsetHeight;
            var visibleTop = container.scrollTop;
            var visibleBottom = visibleTop + container.clientHeight;

            if (itemTop < visibleTop) {
                container.scrollTop = itemTop;
            } else if (itemBottom > visibleBottom) {
                container.scrollTop = itemBottom - container.clientHeight;
            }
        }

        this.start = function() {
            if (typeof Lampa === 'undefined' || !Lampa || !Lampa.Activity) return;
            if (Lampa.Activity.active().activity !== this.activity) return;
            
            if (Lampa.Background && Lampa.Utils) {
                Lampa.Background.immediately(Lampa.Utils.cardImgBackgroundBlur(object.movie));
            }

            if (Lampa.Controller) {
                Lampa.Controller.add('content', {
                    toggle: function() {
                        if (Lampa.Controller.collectionSet) Lampa.Controller.collectionSet(scroll.render(), files.render());
                        if (Lampa.Controller.collectionFocus) Lampa.Controller.collectionFocus(false, scroll.render());
                    },
                    up: function() {
                        if (selectedIndex > 0) { selectedIndex--; updateFocus(); scrollToItem(selectedIndex); }
                        else if (Lampa.Controller.toggle) Lampa.Controller.toggle('head');
                    },
                    down: function() {
                        if (selectedIndex < items.length - 1) { selectedIndex++; updateFocus(); scrollToItem(selectedIndex); }
                    },
                    left: function() { if (Lampa.Controller.toggle) Lampa.Controller.toggle('menu'); },
                    right: function() { playSelected(); },
                    ok: function() { playSelected(); },
                    back: this.back
                });
            }
            this.buildList();
            // Auto-select best source on load
            this.autoSelectBestSource();
            if (Lampa.Controller && Lampa.Controller.toggle) Lampa.Controller.toggle('content');
        };

        function updateFocus() {
            items.forEach(function(item, idx) {
                idx === selectedIndex ? item.addClass('focus') : item.removeClass('focus');
            });
        }

        var isPlayingSource = false;

        function playSelected() {
            if (!sourceItems[selectedIndex]) {
                notify('No source', 'Choose a stream source first', 2000);
                return;
            }

            if (isPlayingSource) return;

            isPlayingSource = true;
            testAndPlay(sourceItems[selectedIndex]).finally(function() {
                isPlayingSource = false;
            });
        }

        async function testAndPlay(sourceData) {
            notify('Testing', 'Extracting direct stream...', 2000);
            const streamInfo = await getDirectStreamUrl(sourceData, object.movie);

            if (streamInfo && streamInfo.url) {
                notify('Playing', sourceData.name + ' ' + streamInfo.type.toUpperCase() + ' stream', 2000);
                try {
                    if (typeof Lampa !== 'undefined' && Lampa && Lampa.Player && typeof Lampa.Player.play === 'function') {
                        Lampa.Player.play({
                            url: streamInfo.url,
                            title: object.movie.title || object.movie.name,
                            quality: streamInfo.type === 'hls' ? 'auto' : undefined
                        });
                    } else {
                        notify('Error', 'Player not available', 3000);
                    }
                } catch (e) {
                    notify('Error', 'Failed to play: ' + e.message, 3000);
                }
            } else {
                notify('No direct stream', sourceData.name + ' did not expose a playable media link', 3000);
            }
        }

        this.back = function() { 
            if (typeof Lampa !== 'undefined' && Lampa && Lampa.Activity) {
                Lampa.Activity.backward(); 
            }
        };
        this.destroy = function() { scroll.destroy(); files.destroy(); html.remove(); items = []; sourceItems = []; };

        // Auto-select the best source based on quality score and speed test
        this.autoSelectBestSource = async function() {
            if (sourceItems.length === 0) return;
            
            notify('Auto-Select', 'Finding best source...', 2000);
            
            var bestIndex = 0;
            var bestScore = -1;
            
            // Test sources in parallel for speed, evaluate quality
            var testPromises = sourceItems.map(async function(source, index) {
                try {
                    const streamInfo = await getDirectStreamUrl(source, object.movie);
                    if (streamInfo && streamInfo.url) {
                        // Calculate quality score
                        var qualityScore = getQualityScore(streamInfo.type, streamInfo.url);
                        // Higher score = better source
                        if (qualityScore > bestScore) {
                            bestScore = qualityScore;
                            bestIndex = index;
                        }
                        return { index: index, success: true, score: qualityScore, type: streamInfo.type };
                    }
                    return { index: index, success: false };
                } catch (e) {
                    return { index: index, success: false, error: e.message };
                }
            });
            
            // Wait for all tests to complete
            var results = await Promise.allSettled(testPromises);
            
            // Find best working source
            var workingSources = results.filter(function(r) {
                return r.status === 'fulfilled' && r.value && r.value.success;
            }).map(function(r) { return r.value; });
            
            if (workingSources.length > 0) {
                // Sort by score descending
                workingSources.sort(function(a, b) { return b.score - a.score; });
                bestIndex = workingSources[0].index;
                console.log('[Multi-Embed] Auto-selected source:', sourceItems[bestIndex].name, 'with score', workingSources[0].score);
            }
            
            selectedIndex = bestIndex;
            updateFocus();
            scrollToItem(selectedIndex);
            
            // Auto-play the best source after a short delay
            setTimeout(function() {
                playSelected();
            }, 500);
        };

        this.buildList = function() {
            html.empty();
            items = [];
            sourceItems = [];
            var sources = getSources(object.movie);
            selectedIndex = 0;

            sources.forEach(function(source, index) {
                var item = $('<div class="online selector" style="padding:1em;margin-bottom:0.5em;background:rgba(255,255,255,0.05);border-radius:0.3em;">' +
                    '<div class="online__title" style="font-size:1.2em;font-weight:bold;">' + source.name + '</div>' +
                    '<div class="online__quality" style="opacity:0.7;">' + (source.type === 'mixed' ? 'Direct endpoint' : 'Resolver scan') + ' | Press OK</div>' +
                    '</div>');

                item.on('hover:focus', function() { selectedIndex = index; updateFocus(); scrollToItem(selectedIndex); });
                item.on('hover:enter hover:click click', function() { selectedIndex = index; updateFocus(); playSelected(); });
                html.append(item);
                items.push(item);
                sourceItems.push(source);
            });

            scroll.append(html);
            if (items.length > 0) items[0].addClass('focus');
            if (typeof Lampa !== 'undefined' && Lampa && Lampa.Controller && Lampa.Controller.enable) {
                Lampa.Controller.enable('content');
            }
        };
    }

    if (typeof Lampa !== 'undefined' && Lampa && Lampa.Component && Lampa.Component.add) {
        Lampa.Component.add('multi_embed_component', MultiEmbedComponent);
    }

    function openMultiEmbed(movie) {
        // Fully automatic - skip UI and play best source immediately
        notify('⚡ Auto-Play', 'Finding best source...', 2000);
        
        const sources = getSources(movie);
        if (sources.length === 0) {
            notify('Error', 'No sources available', 3000);
            return;
        }
        
        // Test all sources in parallel and play the best one
        testAndPlayBest(sources, movie);
    }
    
    async function testAndPlayBest(sources, movie) {
        var bestStream = null;
        var bestScore = -1;
        
        console.log('[Multi-Embed] Testing', sources.length, 'sources for:', movie.title || movie.name);
        
        // Test all sources concurrently with timeout
        var testPromises = sources.map(async function(source) {
            try {
                // Set a timeout for each source test
                const timeoutPromise = new Promise(function(resolve, reject) {
                    setTimeout(function() { reject(new Error('Timeout')); }, 8000);
                });
                
                const streamPromise = getDirectStreamUrl(source, movie);
                const streamInfo = await Promise.race([streamPromise, timeoutPromise]);
                
                if (streamInfo && streamInfo.url) {
                    var qualityScore = getQualityScore(streamInfo.type, streamInfo.url);
                    console.log('[Multi-Embed] Source working:', source.name, 'Type:', streamInfo.type, 'Score:', qualityScore);
                    return { source: source, stream: streamInfo, score: qualityScore };
                }
                console.log('[Multi-Embed] Source failed:', source.name, 'No stream');
                return null;
            } catch (e) {
                console.log('[Multi-Embed] Source failed:', source.name, e.message);
                return null;
            }
        });
        
        var results = await Promise.allSettled(testPromises);
        var workingSources = results
            .filter(function(r) { return r.status === 'fulfilled' && r.value !== null; })
            .map(function(r) { return r.value; });
        
        console.log('[Multi-Embed] Found', workingSources.length, 'working sources');
        
        if (workingSources.length > 0) {
            // Sort by score descending
            workingSources.sort(function(a, b) { return b.score - a.score; });
            bestStream = workingSources[0];
        }
        
        if (bestStream) {
            console.log('[Multi-Embed] Playing best source:', bestStream.source.name, 'Score:', bestStream.score);
            notify('Playing', bestStream.source.name + ' - ' + bestStream.stream.type.toUpperCase() + ' stream', 2000);
            try {
                if (typeof Lampa !== 'undefined' && Lampa && Lampa.Player && typeof Lampa.Player.play === 'function') {
                    Lampa.Player.play({
                        url: bestStream.stream.url,
                        title: movie.title || movie.name,
                        quality: bestStream.stream.type === 'hls' ? 'auto' : undefined
                    });
                } else {
                    notify('Error', 'Player not available', 3000);
                }
            } catch (e) {
                notify('Error', 'Failed to play: ' + e.message, 3000);
            }
        } else {
            console.error('[Multi-Embed] No working streams found. Check console for details.');
            notify('Error', 'No working streams found - check console logs', 4000);
        }
    }

    Lampa.Listener.follow('full', function(e) {
        if (typeof Lampa === 'undefined' || !Lampa) return;
        if (e.type !== 'complite') return;
        var render = e.object.activity.render();
        var movie = e.data.movie;
        if (!render || !movie) return;
        if (render.find('.multiembed-btn').length) return;

        var btn = $('<div class="full-start__button selector multiembed-btn" data-subtitle="Direct streams">⚡ Streams</div>');
        btn.on('hover:enter', function() { 
            if (typeof Lampa !== 'undefined' && Lampa) {
                openMultiEmbed(movie); 
            }
        });

        var playBtn = render.find('.button--play');
        if (playBtn.length) playBtn.before(btn);
        else render.find('.full-start__buttons').append(btn);
    });

    console.log('[Multi-Embed] Plugin initialized.');
})();
