(function() {
    'use strict';
    if (window.VixSrcLampaPlugin) return;
    window.VixSrcLampaPlugin = true;

    // VixSrc Base URL (from the Sootio repository)
    const BASE_URL = 'https://vixsrc.to';

    function buildPageUrl(tmdbId, type, season, episode) {
        if (type === 'series' && season && episode) {
            return `${BASE_URL}/tv/${tmdbId}/${season}/${episode}`;
        }
        return `${BASE_URL}/movie/${tmdbId}`;
    }

    function parseHeightFromPlaylist(playlistText) {
        let maxHeight = 0;
        const regex = /RESOLUTION=\d+x(\d+)/gi;
        let m;
        while ((m = regex.exec(playlistText)) !== null) {
            const h = parseInt(m[1], 10);
            if (!Number.isNaN(h) && h > maxHeight) maxHeight = h;
        }
        return maxHeight || undefined;
    }

    function parseLanguagesFromPlaylist(playlistText) {
        const langs = new Set();
        const regex = /LANGUAGE="([a-z]{2})"/gi;
        let m;
        while ((m = regex.exec(playlistText)) !== null) {
            langs.add(m[1].toLowerCase());
        }
        return Array.from(langs);
    }

    // Smart English Prioritization (Does not filter, just sorts to the top)
    function getEnglishRank(title, langs) {
        let rank = 0;
        const text = (title + ' ' + (langs || []).join(' ')).toLowerCase();
        
        // Bonus for English
        if (text.includes('english') || text.includes('eng') || text.includes('en')) rank += 100;
        if (text.includes('dub')) rank += 20;
        if (text.includes('sub')) rank += 10;
        
        // Penalty for foreign languages and dual-audio
        const nonEnglish = ['hindi', 'russian', 'spanish', 'french', 'german', 'italian', 'portuguese', 'korean', 'japanese', 'chinese', 'arabic', 'turkish', 'latino', 'tamil', 'telugu', 'polish', 'ukrainian'];
        for (const lang of nonEnglish) {
            if (text.includes(lang)) rank -= 100;
        }
        if (text.includes('dual audio') || text.includes('multi-audio') || text.includes('dual-audio') || text.includes('multi')) rank -= 50;
        
        return rank;
    }

    async function fetchVixSrcStreams(movie, season, episode) {
        // Lampa uses TMDB IDs internally, which VixSrc supports directly
        const tmdbId = movie.id; 
        const type = movie.name ? 'series' : 'movie';
        const pageUrl = buildPageUrl(tmdbId, type, season, episode);

        const headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Safari/537.36'
        };

        try {
            const response = await fetch(pageUrl, { headers });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            
            const html = await response.text();
            
            // Extract token, expires, url from HTML
            const tokenMatch = html.match(/['"]token['"]\s*:\s*['"]([^'"]+)['"]/i);
            const expiresMatch = html.match(/['"]expires['"]\s*:\s*['"]([^'"]+)['"]/i);
            const urlMatch = html.match(/url\s*:\s*['"]([^'"]+)['"]/i);

            if (!tokenMatch || !expiresMatch || !urlMatch) {
                // Fallback: Play as an Iframe (VixSrc is a famous iframe provider)
                return [{
                    name: 'VixSrc Embed',
                    title: `${movie.title || movie.name} (VixSrc Embed)\n🔗 Direct Player`,
                    url: pageUrl,
                    iframe: true
                }];
            }

            const baseUrl = new URL(urlMatch[1]);
            const playlistUrl = new URL(`${baseUrl.origin}${baseUrl.pathname}.m3u8${baseUrl.search}`);
            playlistUrl.searchParams.set('token', tokenMatch[1]);
            playlistUrl.searchParams.set('expires', expiresMatch[1]);
            playlistUrl.searchParams.set('h', '1');

            const playlistRes = await fetch(playlistUrl.toString(), { headers: { ...headers, Referer: pageUrl } });
            let playlistText = '';
            if (playlistRes.ok) playlistText = await playlistRes.text();

            const height = playlistText ? parseHeightFromPlaylist(playlistText) : undefined;
            const languages = playlistText ? parseLanguagesFromPlaylist(playlistText) : [];
            const title = `VixSrc ${height || 'Auto'}`;

            return [{
                name: 'VixSrc',
                title: `${movie.title || movie.name}\n🔗 ${title}`,
                url: playlistUrl.toString(),
                resolution: height ? `${height}p` : undefined,
                languages,
                behaviorHints: { bingeGroup: 'vixsrc-streams' }
            }];

        } catch (error) {
            console.error('[VixSrc] Error fetching streams:', error);
            // Fallback to iframe if direct extraction fails
            return [{
                name: 'VixSrc Embed',
                title: `${movie.title || movie.name} (VixSrc Embed)\n🔗 Direct Player`,
                url: pageUrl,
                iframe: true
            }];
        }
    }

    async function playVixSrcAuto(movie, season, episode) {
        Lampa.Noty.show('🔍 Fetching VixSrc streams...');
        
        const streams = await fetchVixSrcStreams(movie, season, episode);
        if (!streams || streams.length === 0) {
            Lampa.Noty.show('❌ No streams found from VixSrc.');
            return;
        }

        // Sort by English priority
        streams.sort((a, b) => {
            const rankA = getEnglishRank(a.title, a.languages);
            const rankB = getEnglishRank(b.title, b.languages);
            if (rankA !== rankB) return rankB - rankA;
            return 0;
        });

        const best = streams[0];
        Lampa.Noty.show('▶️ Playing: ' + best.name);

        if (best.iframe) {
            // Lampa can play iframes natively
            Lampa.Player.play({
                url: best.url,
                title: movie.title || movie.name,
                iframe: true
            });
        } else {
            const entry = {
                url: best.url,
                title: movie.title || movie.name,
                subtitles: []
            };
            Lampa.Player.play(entry);
            Lampa.Player.playlist([entry]);
        }
    }

    // --- LAMPA UI INTEGRATION ---
    if (Lampa.Online && Lampa.Online.register) {
        Lampa.Online.register('vixsrc_auto', {
            title: '🎬 VixSrc Auto',
            search: function(movie, oncomplite) {
                const season = movie.season_number || movie.season;
                const episode = movie.episode_number || movie.episode;
                playVixSrcAuto(movie, season, episode);
                if (oncomplite) oncomplite([]);
            },
            onContextMenu: function() { return { name: '🎬 VixSrc Auto' }; }
        });
    }

    Lampa.Listener.follow('full', function(e) {
        if (e.type !== 'complite') return;
        const render = e.object.activity.render();
        const movie = e.data.movie;
        if (render.find('.vixsrc-auto-btn').length) return;

        const btn = $(`
            <div class="full-start__button selector vixsrc-auto-btn" data-subtitle="VixSrc Auto-Play">
                🎬 VixSrc Auto
            </div>
        `);

        btn.on('hover:enter', function() {
            const season = movie.season_number || movie.season;
            const episode = movie.episode_number || movie.episode;
            playVixSrcAuto(movie, season, episode);
        });

        const playBtn = render.find('.button--play');
        if (playBtn.length) playBtn.before(btn);
        else render.find('.full-start__buttons').append(btn);
    });

    console.log('[VixSrc Auto] Plugin initialized.');
})();
