(function() {
    'use strict';
    if (window.MultiEmbedPlugin) return;
    window.MultiEmbedPlugin = true;

    // --- 1. RELIABLE IFRAME SOURCES ---
    function getSources(movie) {
        const tmdbId = movie.id;
        const isSeries = !!(movie.name && movie.first_air_date);
        const season = movie.season_number || movie.season || 1;
        const episode = movie.episode_number || movie.episode || 1;

        const sources = [];

        if (isSeries) {
            sources.push({ name: 'VidSrc.xyz', url: `https://vidsrc.xyz/embed/tv/${tmdbId}/${season}/${episode}` });
            sources.push({ name: 'VidSrc.cc', url: `https://vidsrc.cc/embed/tv/${tmdbId}/${season}/${episode}` });
            sources.push({ name: 'Embed.su', url: `https://embed.su/embed/tv/${tmdbId}/${season}/${episode}` });
            sources.push({ name: 'AutoEmbed', url: `https://autoembed.co/tv/tmdb/${tmdbId}-${season}-${episode}` });
            sources.push({ name: 'MoviesAPI', url: `https://moviesapi.club/tv/${tmdbId}-${season}-${episode}` });
            sources.push({ name: '2Embed', url: `https://www.2embed.to/embed/tmdb/tv?id=${tmdbId}&s=${season}&e=${episode}` });
            sources.push({ name: 'MultiEmbed', url: `https://multiembed.mov/directstream.php?video_id=${tmdbId}&tmdb=1&s=${season}&e=${episode}` });
            sources.push({ name: 'SmashyStream', url: `https://embed.smashy.stream/tv/${tmdbId}/${season}/${episode}` });
            sources.push({ name: 'SuperEmbed', url: `https://superembed.stream/tv/${tmdbId}/${season}/${episode}` });
        } else {
            sources.push({ name: 'VidSrc.xyz', url: `https://vidsrc.xyz/embed/movie/${tmdbId}` });
            sources.push({ name: 'VidSrc.cc', url: `https://vidsrc.cc/embed/movie/${tmdbId}` });
            sources.push({ name: 'Embed.su', url: `https://embed.su/embed/movie/${tmdbId}` });
            sources.push({ name: 'AutoEmbed', url: `https://autoembed.co/movie/tmdb/${tmdbId}` });
            sources.push({ name: 'MoviesAPI', url: `https://moviesapi.club/movie/${tmdbId}` });
            sources.push({ name: '2Embed', url: `https://www.2embed.to/embed/tmdb/movie?id=${tmdbId}` });
            sources.push({ name: 'MultiEmbed', url: `https://multiembed.mov/?video_id=${tmdbId}&tmdb=1` });
            sources.push({ name: 'SmashyStream', url: `https://embed.smashy.stream/movie/${tmdbId}` });
            sources.push({ name: 'SuperEmbed', url: `https://superembed.stream/movie/${tmdbId}` });
        }
        return sources;
    }

    // --- 2. LAMPA UI COMPONENT ---
    function MultiEmbedComponent(object) {
        var scroll = new Lampa.Scroll({ mask: true, over: true });
        var files = new Lampa.Explorer(object);
        var html = $('<div></div>');

        this.create = function () {
            scroll.minus();
            files.appendFiles(scroll.render());
            files.appendHead($('<div class="simple-text" style="padding: 1em; text-align: center; font-size: 1.2em;">Select an Embed Source</div>'));
            return this.render();
        };

        this.render = function () { return files.render(); };

        this.start = function () {
            if (Lampa.Activity.active().activity !== this.activity) return;
            Lampa.Background.immediately(Lampa.Utils.cardImgBackgroundBlur(object.movie));
            Lampa.Controller.add('content', {
                toggle: function () {
                    Lampa.Controller.collectionSet(scroll.render(), files.render());
                    Lampa.Controller.collectionFocus(false, scroll.render());
                },
                up: function () { if (Navigator.canmove('up')) Navigator.move('up'); else Lampa.Controller.toggle('head'); },
                down: function () { Navigator.move('down'); },
                left: function () { Lampa.Controller.toggle('menu'); },
                right: function () { Navigator.move('right'); },
                back: this.back
            });
            Lampa.Controller.toggle('content');
            this.buildList();
        };

        this.back = function () { Lampa.Activity.backward(); };
        this.destroy = function () { scroll.destroy(); files.destroy(); html.remove(); };

        this.buildList = function () {
            html.empty();
            var sources = getSources(object.movie);
            
            sources.forEach(function (source) {
                // Removed Lampa.Utils.escape to prevent crashes
                var item = $(
                    '<div class="online selector" style="padding: 1em; margin-bottom: 0.5em; background: rgba(255,255,255,0.05); border-radius: 0.3em;">' +
                    '<div class="online__title" style="font-size: 1.2em; font-weight: bold;">' + source.name + '</div>' +
                    '<div class="online__quality" style="opacity: 0.7;">Iframe Player (Subtitles/Audio selectable inside player)</div>' +
                    '</div>'
                );

                item.on('hover:enter', function () {
                    // Play via Lampa's native Iframe player
                    Lampa.Player.play({
                        url: source.url,
                        title: object.movie.title || object.movie.name,
                        iframe: true
                    });
                });

                html.append(item);
            });

            scroll.append(html);
            Lampa.Controller.enable('content');
        };
    }

    // Register the component globally
    if (Lampa.Component && Lampa.Component.add) {
        Lampa.Component.add('multi_embed_component', MultiEmbedComponent);
    }

    function openMultiEmbed(movie) {
        Lampa.Activity.push({
            url: '',
            title: 'Multi-Embed Sources',
            component: 'multi_embed_component',
            movie: movie,
            page: 1
        });
    }

    // --- 3. UI INTEGRATION ---
    // Inject button directly onto the Movie/TV Show details page
    Lampa.Listener.follow('full', function(e) {
        if (e.type !== 'complite') return;
        var render = e.object.activity.render();
        var movie = e.data.movie;
        
        if (render.find('.multi-embed-btn').length) return;

        var btn = $(
            '<div class="full-start__button selector multi-embed-btn" data-subtitle="Multi-Embed Sources">' +
            '🌐 Multi-Embed' +
            '</div>'
        );

        btn.on('hover:enter', function() {
            openMultiEmbed(movie);
        });

        var playBtn = render.find('.button--play');
        if (playBtn.length) playBtn.before(btn);
        else render.find('.full-start__buttons').append(btn);
    });

    console.log('[Multi-Embed] Plugin initialized successfully.');
})();
