        } else {
            // Movie sources
            sources.push({ 
                name: 'VidSrc.to', 
                url: `https://vidsrc.to/embed/movie/${tmdbId}`,
                type: 'iframe',
                priority: 1
            });
            sources.push({ 
                name: 'VidSrc.xyz', 
                url: `https://vidsrc.xyz/embed/movie/${tmdbId}`,
                type: 'iframe',
                priority: 2
            });
            sources.push({ 
                name: 'Embed.su', 
                url: `https://embed.su/embed/movie/${tmdbId}`,
                type: 'iframe',
                priority: 3
            });
            sources.push({ 
                name: 'AutoEmbed', 
                url: `https://autoembed.co/movie/tmdb/${tmdbId}`,
